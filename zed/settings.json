// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "shell": {
      "program": "nu",
    },
  },
  "language_models": {
    "openai_compatible": {
      "智谱": {
        "api_url": "https://open.bigmodel.cn/api/coding/paas/v4",
        "available_models": [
          {
            "name": "glm-5.2",
            "max_tokens": 1000000,
            "max_output_tokens": 131072,
            "max_completion_tokens": 131072,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
        ],
      },
    },
  },
  "agent": {
    "default_profile": "write",
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [{ "pattern": ".*" }],
        },
        "terminal": {
          "always_allow": [
            // 文件和目录查看（只读操作）
            { "pattern": "^ls\\s+.*$" },
            { "pattern": "^tree\\s+.*$" },
            { "pattern": "^pwd\\s*$" },
            { "pattern": "^cat\\s+.*$" },
            { "pattern": "^head\\s+.*$" },
            { "pattern": "^tail\\s+.*$" },
            { "pattern": "^less\\s+.*$" },
            { "pattern": "^more\\s+.*$" },
            // 文件查找
            { "pattern": "^find\\s+.*$" },
            { "pattern": "^locate\\s+.*$" },
            // 文本搜索
            { "pattern": "^grep\\s+.*$" },
            { "pattern": "^rg\\s+.*$" },
            { "pattern": "^ag\\s+.*$" },
            { "pattern": "^ack\\s+.*$" },
            // 统计信息
            { "pattern": "^wc\\s+.*$" },
            { "pattern": "^du\\s+.*$" },
            { "pattern": "^df\\s+.*$" },
            // Git 只读操作
            { "pattern": "^git\\s+status\\b.*$" },
            { "pattern": "^git\\s+log\\b.*$" },
            { "pattern": "^git\\s+diff\\b.*$" },
            { "pattern": "^git\\s+branch\\b.*$" },
            { "pattern": "^git\\s+show\\b.*$" },
            { "pattern": "^git\\s+remote\\b.*$" },
            { "pattern": "^git\\s+rev-parse\\b.*$" },
            { "pattern": "^git\\s+config\\s+--get\\b.*$" },
            // 系统信息
            { "pattern": "^which\\s+.*$" },
            { "pattern": "^whoami\\s*$" },
            { "pattern": "^hostname\\s*$" },
            { "pattern": "^uname\\s+.*$" },
            { "pattern": "^echo\\s+.*$" },
            { "pattern": "^date\\s*$" },
            { "pattern": "^type\\s+.*$" },
            // 安全的文件创建操作
            { "pattern": "^mkdir\\s+.*$" },
            { "pattern": "^touch\\s+.*$" },
            // Rust/Cargo 命令（安全的构建、测试、检查操作）
            { "pattern": "^cargo\\s+check\\b.*$" },
            { "pattern": "^cargo\\s+build\\b.*$" },
            { "pattern": "^cargo\\s+test\\b.*$" },
            { "pattern": "^cargo\\s+clippy\\b.*$" },
            { "pattern": "^cargo\\s+fmt\\s+--check\\b.*$" },
            { "pattern": "^cargo\\s+doc\\b.*$" },
            { "pattern": "^cargo\\s+metadata\\b.*$" },
            { "pattern": "^cargo\\s+tree\\b.*$" },
            { "pattern": "^cargo\\s+--version\\s*$" },
            { "pattern": "^cargo\\s+-V\\s*$" },
            { "pattern": "^rustc\\s+--version\\s*$" },
            { "pattern": "^rustup\\s+show\\b.*$" },
            { "pattern": "^rustup\\s+toolchain\\s+list\\s*$" },
            // JavaScript/Node/npm/yarn/pnpm 命令（安全的构建、测试、查看操作）
            { "pattern": "^npm\\s+run\\b.*$" },
            { "pattern": "^npm\\s+test\\b.*$" },
            { "pattern": "^npm\\s+build\\b.*$" },
            { "pattern": "^npm\\s+list\\b.*$" },
            { "pattern": "^npm\\s+ls\\b.*$" },
            { "pattern": "^npm\\s+outdated\\b.*$" },
            { "pattern": "^npm\\s+--version\\s*$" },
            { "pattern": "^npm\\s+-v\\s*$" },
            { "pattern": "^node\\s+--version\\s*$" },
            { "pattern": "^node\\s+-v\\s*$" },
            { "pattern": "^npx\\s+--version\\s*$" },
            { "pattern": "^yarn\\s+--version\\s*$" },
            { "pattern": "^yarn\\s+-v\\s*$" },
            { "pattern": "^yarn\\s+run\\b.*$" },
            { "pattern": "^yarn\\s+test\\b.*$" },
            { "pattern": "^yarn\\s+build\\b.*$" },
            { "pattern": "^yarn\\s+list\\b.*$" },
            { "pattern": "^yarn\\s+outdated\\b.*$" },
            { "pattern": "^pnpm\\s+--version\\s*$" },
            { "pattern": "^pnpm\\s+-v\\s*$" },
            { "pattern": "^pnpm\\s+run\\b.*$" },
            { "pattern": "^pnpm\\s+test\\b.*$" },
            { "pattern": "^pnpm\\s+build\\b.*$" },
            { "pattern": "^pnpm\\s+list\\b.*$" },
            { "pattern": "^pnpm\\s+outdated\\b.*$" },
          ],
        },
      },
    },
    "default_model": {
      "provider": "智谱",
      "model": "glm-5.2",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": false,
    },
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "use_smartcase_search": true,
  "colorize_brackets": true,
  "project_panel": {
    "hide_hidden": false,
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "closingBraceHints": {
            "enable": true,
            "minLines": 5,
          },
        },
      },
    },
  },
  "languages": {
    "Rust": {
      "inlay_hints": {
        "enabled": true,
      },
    },
    "TypeScript": {
      "language_servers": [
        "...",
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "TSX": {
      "language_servers": [
        "...",
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "JavaScript": {
      "language_servers": [
        "...",
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-",
          ],
        },
      },
    },
  },
  "relative_line_numbers": "wrapped",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": "Catppuccin Mocha",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "status_bar": {
    "active_encoding_button": "enabled",
    "cursor_position_button": true,
    "line_endings_button": true,
  },
}
